PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8800
PLATFORM_DATA_DIR=./data
PLATFORM_DB_URL=
PLATFORM_SECRET_KEY=change-this-in-production
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=admin123
PLATFORM_TIMEZONE=Asia/Shanghai
PLATFORM_ENABLE_WORKER=1
PLATFORM_ENABLE_SCHEDULER=1
PLATFORM_GF3_EXE=gf3
PLATFORM_MB_EXE=
PLATFORM_MB_USER=
# 本地 MB 机柜编号，多个用逗号分隔；留空时尝试从已登记设备推断
PLATFORM_MB_TER_IDS=
# 客户侧 Agent 上报令牌，多个可用逗号分隔；留空则关闭 Agent 上报接口
PLATFORM_AGENT_TOKEN=
# 可选：令牌与 Agent 绑定，格式 code=token;code=token
# 配置后，每个令牌只能领取/回传自己绑定的 Agent 任务
PLATFORM_AGENT_TOKEN_MAP=

# 执行机（单机部署时保持 local）
PLATFORM_AGENT_CODE=local
PLATFORM_AGENT_NAME=

# USB 机器人（https://www.mbiai.com）设备同步，留空则不启用
PLATFORM_USB_ROBOT_BASE_URL=https://www.mbiai.com
PLATFORM_USB_ROBOT_TOKEN=
PLATFORM_USB_ROBOT_USER_NO=
PLATFORM_USB_ROBOT_POINT_NO=
PLATFORM_USB_ROBOT_PASSWD=
PLATFORM_USB_ROBOT_WEB_IP=
PLATFORM_USB_ROBOT_LIST_TYPE=0

# 采集程序清单，留空用 platform/collectors.yaml；文件不存在时全部走源码模式（开发者模式）
PLATFORM_COLLECTORS_FILE=
# 源码模式下跑采集用的 python，留空用平台自身的解释器
PLATFORM_COLLECTOR_PYTHON=
