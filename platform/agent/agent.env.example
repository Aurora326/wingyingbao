# 客户侧 MB 设备上报 Agent 配置示例
# 复制为 agent.env 后填写；不要把该文件提交到代码仓库。

PLATFORM_URL=https://your-platform.example.com
PLATFORM_AGENT_TOKEN=从平台 .env 的 PLATFORM_AGENT_TOKEN 复制
PLATFORM_AGENT_CODE=cust-1517
PLATFORM_AGENT_NAME=客户机房采集盒子
PLATFORM_MB_TER_IDS=068330001517
PLATFORM_MB_EXE=C:\mb\mb.exe
PLATFORM_REPORT_INTERVAL=300

# 采集任务下发：客户机需要同时部署 platform/collector 和浏览器依赖
PLATFORM_TASK_POLL_INTERVAL=15
PLATFORM_TASK_TIMEOUT=900
PLATFORM_AGENT_WORK_DIR=C:\platform-agent\work
PLATFORM_COLLECTOR_PYTHON=python
PLATFORM_COLLECTOR_ROOT=C:\platform-agent
PLATFORM_GF3_EXE=gf3
PLATFORM_MB_USER=
