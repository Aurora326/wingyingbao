[Version]
Signature="$Windows NT$"
Class=Keyboard
ClassGuid={4d36e96b-e325-11ce-bfc1-08002be10318}
Provider=%Manufacturer%
DriverVer = 11/06/2023,22.0.20.598
CatalogFile= AiKeyboard.cat

[Manufacturer]
%Manufacturer% = VKBModels,NTamd64

[VKBModels.NTamd64]
%AiKeyboard% = VKboard.Install, AiKeyboard

[DestinationDirs]
DefaultDestDir  = 12

[SourceDisksFiles]
AiKeyboard.sys=1

[SourceDisksNames]
1="Install #1"

[VKboard.Install.NTamd64]
CopyFiles=VKboardFiles

[VKboardFiles]
AiKeyboard.sys,,,%COPYFLG_NOSKIP%

[VKboard.Install.NTamd64.Services]
AddService = AiIndeedVirtualKeyboard, %SPSVCINST_ASSOCSERVICE%, VKboard.Service

[VKboard.Service]
DisplayName    = %SERVICE_DISPLAY_NAME%
ServiceType    = %SERVICE_KERNEL_DRIVER%
StartType      = %SERVICE_BOOT_START%
ErrorControl   = %SERVICE_ERROR_NORMAL%
ServiceBinary  = %12%\AiKeyboard.sys
LoadOrderGroup = Boot Bus Extender

[Strings]
Manufacturer = "AiIndeed"
AiKeyboard = "AiIndeed Virtual Keyboard"

COPYFLG_NOSKIP=2

SERVICE_KERNEL_DRIVER=1
SERVICE_AUTO_START=2
SERVICE_BOOT_START=0
SERVICE_ERROR_NORMAL=1
SERVICE_DISPLAY_NAME="AiIndeed Virtual Keybord Function Driver"

SPSVCINST_ASSOCSERVICE=0x00000002

